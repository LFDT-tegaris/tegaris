{
  "$defs": {
    "Bcp47": {
      "maxLength": 35,
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "Duration": {
      "pattern": "^(0|[1-9][0-9]*)(ms|s|m|h|d)$",
      "type": "string"
    },
    "IanaTimezone": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(UTC|[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)+)$",
      "type": "string"
    },
    "ProfileRef": {
      "pattern": "^profile://[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._/-]{1,192}@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "PublisherSetRef": {
      "pattern": "^publisher-set://[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._/-]{1,192}@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "QualificationRef": {
      "pattern": "^qualification://[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._/-]{1,192}@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SecretRef": {
      "pattern": "^secret://[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._/-]{1,192}#[A-Za-z0-9._-]{1,96}$",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TypedUrn": {
      "pattern": "^urn:openpc:[a-z][a-z0-9-]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "urn:openpc:schema:effective-configuration:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Final AF-25 effective configuration. Profile-required values have no invented default and must be supplied by a signed, qualified input before this schema is evaluated.",
  "properties": {
    "environmentId": {
      "pattern": "^[a-z][a-z0-9-]{2,31}$",
      "type": "string"
    },
    "features": {
      "additionalProperties": false,
      "properties": {
        "clientIndexerCompatibility": {
          "default": false,
          "type": "boolean"
        },
        "explorerFactSource": {
          "default": false,
          "type": "boolean"
        },
        "optionalValkeyCache": {
          "default": false,
          "type": "boolean"
        },
        "privacyExplorerIntegration": {
          "default": false,
          "type": "boolean"
        },
        "subqueryConditional": {
          "const": false
        }
      },
      "required": [
        "privacyExplorerIntegration",
        "explorerFactSource",
        "clientIndexerCompatibility",
        "subqueryConditional",
        "optionalValkeyCache"
      ],
      "type": "object"
    },
    "generation": {
      "additionalProperties": false,
      "properties": {
        "baseGenerationId": {
          "$ref": "#/$defs/TypedUrn"
        },
        "contentDigest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "generationId": {
          "$ref": "#/$defs/TypedUrn"
        }
      },
      "required": [
        "generationId",
        "baseGenerationId",
        "contentDigest"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "clientId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "clientSecretRef": {
          "$ref": "#/$defs/SecretRef"
        },
        "oidcIssuer": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "scimEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "oidcIssuer",
        "clientId",
        "clientSecretRef",
        "scimEnabled"
      ],
      "type": "object"
    },
    "pki": {
      "additionalProperties": false,
      "properties": {
        "signingKeySecretRef": {
          "$ref": "#/$defs/SecretRef"
        },
        "trustBundleSecretRef": {
          "$ref": "#/$defs/SecretRef"
        }
      },
      "required": [
        "trustBundleSecretRef",
        "signingKeySecretRef"
      ],
      "type": "object"
    },
    "postgres": {
      "additionalProperties": false,
      "properties": {
        "candidateIndexDsnSecretRef": {
          "$ref": "#/$defs/SecretRef"
        },
        "controlDsnSecretRef": {
          "$ref": "#/$defs/SecretRef"
        },
        "factsDsnSecretRef": {
          "$ref": "#/$defs/SecretRef"
        }
      },
      "required": [
        "controlDsnSecretRef",
        "factsDsnSecretRef",
        "candidateIndexDsnSecretRef"
      ],
      "type": "object"
    },
    "profile": {
      "enum": [
        "local",
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "publicBaseUrl": {
      "format": "uri",
      "pattern": "^https://",
      "type": "string"
    },
    "qualificationInputBindings": {
      "additionalProperties": false,
      "patternProperties": {
        "^(ui\\.export_row_limit|runtime\\.local_artifact_capacity|runtime\\.decision_deadline|evidence\\.local_spool_capacity|evidence\\.retention_profile|provider\\.read_retry_limit|facts\\.maximum_staleness|facts\\.reorg_retained_tail|module\\.allowed_publishers|module\\.ui_slot_budget)$": {
          "$ref": "#/$defs/QualificationRef"
        }
      },
      "required": [
        "ui.export_row_limit",
        "runtime.local_artifact_capacity",
        "runtime.decision_deadline",
        "evidence.local_spool_capacity",
        "evidence.retention_profile",
        "provider.read_retry_limit",
        "facts.maximum_staleness",
        "facts.reorg_retained_tail",
        "module.allowed_publishers",
        "module.ui_slot_budget"
      ],
      "type": "object"
    },
    "runtimePaths": {
      "additionalProperties": false,
      "properties": {
        "artifactRoot": {
          "const": "/var/lib/openpc/artifacts"
        },
        "brokerUdsPath": {
          "const": "/run/openpc/broker.sock"
        },
        "envoyAdminBind": {
          "const": "127.0.0.1:9901"
        },
        "evidenceRoot": {
          "const": "/var/lib/openpc/evidence"
        },
        "pdsUdsPath": {
          "const": "/run/openpc/pds.sock"
        }
      },
      "required": [
        "envoyAdminBind",
        "pdsUdsPath",
        "brokerUdsPath",
        "artifactRoot",
        "evidenceRoot"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "settings": {
      "additionalProperties": false,
      "properties": {
        "approval.default_expiry": {
          "$ref": "#/$defs/Duration",
          "default": "24h",
          "x-openpc-maxMilliseconds": 2592000000,
          "x-openpc-minMilliseconds": 300000
        },
        "approval.protected_action_min_checkers": {
          "default": 2,
          "maximum": 9,
          "minimum": 1,
          "type": "integer"
        },
        "evidence.critical_watermark": {
          "default": 95,
          "maximum": 99,
          "minimum": 51,
          "type": "integer"
        },
        "evidence.export_retry_limit": {
          "default": 20,
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "evidence.high_watermark": {
          "default": 80,
          "maximum": 98,
          "minimum": 50,
          "type": "integer"
        },
        "evidence.local_spool_capacity": {
          "minimum": 1,
          "type": "integer"
        },
        "evidence.retention_profile": {
          "$ref": "#/$defs/ProfileRef"
        },
        "facts.maximum_staleness": {
          "$ref": "#/$defs/Duration",
          "x-openpc-minMilliseconds": 1
        },
        "facts.reorg_retained_tail": {
          "minimum": 1,
          "type": "integer"
        },
        "facts.shard_entry_limit": {
          "default": 1000000,
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "identity.clock_skew_tolerance": {
          "$ref": "#/$defs/Duration",
          "default": "30s",
          "x-openpc-maxMilliseconds": 120000,
          "x-openpc-minMilliseconds": 0
        },
        "identity.context_assertion_ttl": {
          "$ref": "#/$defs/Duration",
          "default": "2m",
          "x-openpc-maxMilliseconds": 600000,
          "x-openpc-minMilliseconds": 10000
        },
        "identity.external_group_freshness_max": {
          "$ref": "#/$defs/Duration",
          "default": "15m",
          "x-openpc-maxMilliseconds": 86400000,
          "x-openpc-minMilliseconds": 60000
        },
        "identity.scim_mass_change_threshold": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "module.allowed_publishers": {
          "$ref": "#/$defs/PublisherSetRef"
        },
        "module.require_provenance": {
          "const": true,
          "default": true
        },
        "module.require_sbom": {
          "const": true,
          "default": true
        },
        "module.ui_slot_budget": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "operations.incident_restriction_lease": {
          "$ref": "#/$defs/Duration",
          "default": "15m",
          "x-openpc-maxMilliseconds": 86400000,
          "x-openpc-minMilliseconds": 60000
        },
        "operations.notification_delivery_limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "participant.envelope_expiry_warning": {
          "$ref": "#/$defs/Duration",
          "default": "30d",
          "x-openpc-maxMilliseconds": 31536000000,
          "x-openpc-minMilliseconds": 86400000
        },
        "participant.first_admin_invite_ttl": {
          "$ref": "#/$defs/Duration",
          "default": "24h",
          "x-openpc-maxMilliseconds": 604800000,
          "x-openpc-minMilliseconds": 900000
        },
        "participant.review_default_period": {
          "$ref": "#/$defs/Duration",
          "default": "90d",
          "x-openpc-maxMilliseconds": 63072000000,
          "x-openpc-minMilliseconds": 86400000
        },
        "policy.conflict_severity_block_threshold": {
          "default": "ERROR",
          "enum": [
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "policy.draft_inactivity_expiry": {
          "$ref": "#/$defs/Duration",
          "default": "90d",
          "x-openpc-maxMilliseconds": 63072000000,
          "x-openpc-minMilliseconds": 604800000
        },
        "policy.simulation_case_limit": {
          "default": 10000,
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "provider.health_observation_window": {
          "$ref": "#/$defs/Duration",
          "default": "60s",
          "x-openpc-maxMilliseconds": 3600000,
          "x-openpc-minMilliseconds": 5000
        },
        "provider.quarantine_on_fingerprint_drift": {
          "default": true,
          "type": "boolean"
        },
        "provider.read_retry_limit": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "provider.write_retry_after_attempt_start": {
          "const": 0,
          "default": 0
        },
        "release.activation_token_ttl": {
          "$ref": "#/$defs/Duration",
          "default": "2m",
          "x-openpc-maxMilliseconds": 600000,
          "x-openpc-minMilliseconds": 10000
        },
        "release.mandatory_target_policy": {
          "const": "ALL_ELIGIBLE",
          "default": "ALL_ELIGIBLE"
        },
        "release.receipt_recovery_window": {
          "$ref": "#/$defs/Duration",
          "default": "24h",
          "x-openpc-maxMilliseconds": 2592000000,
          "x-openpc-minMilliseconds": 3600000
        },
        "release.stage_timeout": {
          "$ref": "#/$defs/Duration",
          "default": "10m",
          "x-openpc-maxMilliseconds": 86400000,
          "x-openpc-minMilliseconds": 30000
        },
        "runtime.capsule_retained_active_generations": {
          "default": 2,
          "maximum": 10,
          "minimum": 2,
          "type": "integer"
        },
        "runtime.decision_deadline": {
          "$ref": "#/$defs/Duration",
          "x-openpc-minMilliseconds": 1
        },
        "runtime.fail_closed_on_unknown_version": {
          "const": true,
          "default": true
        },
        "runtime.local_artifact_capacity": {
          "minimum": 1,
          "type": "integer"
        },
        "runtime.staged_generation_limit": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "security.audit_reason_required": {
          "const": true,
          "default": true
        },
        "security.sensitive_copy_disabled": {
          "default": true,
          "type": "boolean"
        },
        "session.absolute_timeout": {
          "$ref": "#/$defs/Duration",
          "default": "12h",
          "x-openpc-maxMilliseconds": 604800000
        },
        "session.idle_timeout": {
          "$ref": "#/$defs/Duration",
          "default": "30m",
          "x-openpc-maxMilliseconds": 86400000,
          "x-openpc-minMilliseconds": 60000
        },
        "session.step_up_validity": {
          "$ref": "#/$defs/Duration",
          "default": "5m",
          "x-openpc-maxMilliseconds": 1800000,
          "x-openpc-minMilliseconds": 0
        },
        "telemetry.metric_card_stale_after": {
          "$ref": "#/$defs/Duration",
          "default": "5m",
          "x-openpc-maxMilliseconds": 86400000,
          "x-openpc-minMilliseconds": 10000
        },
        "telemetry.payload_capture_enabled": {
          "const": false,
          "default": false
        },
        "ui.default_density": {
          "default": "COMFORTABLE",
          "enum": [
            "COMFORTABLE",
            "COMPACT"
          ]
        },
        "ui.default_locale": {
          "$ref": "#/$defs/Bcp47",
          "default": "en"
        },
        "ui.default_theme": {
          "default": "SYSTEM",
          "enum": [
            "SYSTEM",
            "LIGHT",
            "DARK",
            "HIGH_CONTRAST"
          ]
        },
        "ui.default_timezone": {
          "$ref": "#/$defs/IanaTimezone",
          "default": "UTC"
        },
        "ui.export_row_limit": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "ui.page_size_default": {
          "default": 50,
          "maximum": 200,
          "minimum": 10,
          "type": "integer"
        },
        "ui.page_size_max": {
          "default": 200,
          "maximum": 1000,
          "minimum": 50,
          "type": "integer"
        }
      },
      "required": [
        "ui.default_locale",
        "ui.default_timezone",
        "ui.default_density",
        "ui.default_theme",
        "ui.page_size_default",
        "ui.page_size_max",
        "ui.export_row_limit",
        "session.idle_timeout",
        "session.absolute_timeout",
        "session.step_up_validity",
        "identity.context_assertion_ttl",
        "identity.clock_skew_tolerance",
        "identity.scim_mass_change_threshold",
        "identity.external_group_freshness_max",
        "approval.default_expiry",
        "approval.protected_action_min_checkers",
        "participant.first_admin_invite_ttl",
        "participant.envelope_expiry_warning",
        "participant.review_default_period",
        "policy.draft_inactivity_expiry",
        "policy.simulation_case_limit",
        "policy.conflict_severity_block_threshold",
        "release.mandatory_target_policy",
        "release.stage_timeout",
        "release.activation_token_ttl",
        "release.receipt_recovery_window",
        "runtime.capsule_retained_active_generations",
        "runtime.staged_generation_limit",
        "runtime.local_artifact_capacity",
        "runtime.decision_deadline",
        "runtime.fail_closed_on_unknown_version",
        "evidence.local_spool_capacity",
        "evidence.high_watermark",
        "evidence.critical_watermark",
        "evidence.export_retry_limit",
        "evidence.retention_profile",
        "provider.health_observation_window",
        "provider.quarantine_on_fingerprint_drift",
        "provider.read_retry_limit",
        "provider.write_retry_after_attempt_start",
        "facts.maximum_staleness",
        "facts.reorg_retained_tail",
        "facts.shard_entry_limit",
        "module.allowed_publishers",
        "module.require_sbom",
        "module.require_provenance",
        "module.ui_slot_budget",
        "operations.incident_restriction_lease",
        "operations.notification_delivery_limit",
        "security.audit_reason_required",
        "security.sensitive_copy_disabled",
        "telemetry.payload_capture_enabled",
        "telemetry.metric_card_stale_after"
      ],
      "type": "object"
    },
    "telemetry": {
      "additionalProperties": false,
      "properties": {
        "collectorVersion": {
          "const": "0.159.0"
        },
        "otlpEndpoint": {
          "format": "uri",
          "pattern": "^(https|grpc)://",
          "type": "string"
        },
        "privacyProfile": {
          "const": "STRICT_REDACTED"
        }
      },
      "required": [
        "otlpEndpoint",
        "privacyProfile",
        "collectorVersion"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "environmentId",
    "publicBaseUrl",
    "generation",
    "postgres",
    "identity",
    "pki",
    "runtimePaths",
    "telemetry",
    "qualificationInputBindings",
    "features",
    "settings"
  ],
  "title": "OpenPC closed effective deployment configuration",
  "type": "object",
  "x-openpc-crossConstraints": [
    "settings['ui.page_size_default'] <= settings['ui.page_size_max']",
    "duration(settings['session.idle_timeout']) < duration(settings['session.absolute_timeout'])",
    "duration(settings['session.step_up_validity']) <= duration(settings['session.idle_timeout'])",
    "duration(settings['identity.context_assertion_ttl']) > duration(settings['identity.clock_skew_tolerance'])",
    "settings['evidence.high_watermark'] < settings['evidence.critical_watermark']",
    "profile != 'production' || settings['provider.quarantine_on_fingerprint_drift'] == true",
    "profile != 'production' || settings['security.sensitive_copy_disabled'] == true"
  ],
