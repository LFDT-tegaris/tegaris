# Non-secret reference only; this is not a complete bootstrap configuration.
# The bounded local runner owns all credentials, certificates, adapter bundles
# and generated target configuration. Follow README.md rather than constructing
# a partial secret set or launching an unguarded Compose build.
COMPOSE_PROJECT_NAME=openpc-local
OPENPC_LOCAL_SECRET_ROOT=./secrets
OPENPC_LOCAL_DATA_ROOT=/absolute/path/to/openpc-local-data

# Newly issued recovery only. Normal maxima: 15m custody, 1h administrator scopes.
# Explicit local QA may use up to 1h custody / 24h scopes, within current Root and source validity.
IDENTITY_RECOVERY_LEASE_TTL_MS=900000
IDENTITY_RECOVERY_ADMINISTRATOR_TTL_MS=3600000
