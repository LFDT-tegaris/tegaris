        "serialization": "YAML_STRING"
      },
      "OPENPC_INPUT_SECRETREFS_EVIDENCE_VAULT": {
        "pointer": "/secretRefs/evidenceVault",
        "serialization": "YAML_STRING"
      },
      "OPENPC_INPUT_SECRETREFS_FACT_POSTGRES": {
