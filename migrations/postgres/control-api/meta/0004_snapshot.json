          "value": "\"control\".\"configuration_work\".\"input_digest\" ~ '^sha256:[0-9a-f]{64}$'"
        },
        "configuration_work_configuration_digest_ck": {
          "name": "configuration_work_configuration_digest_ck",
          "value": "\"control\".\"configuration_work\".\"configuration_digest\" ~ '^sha256:[0-9a-f]{64}$'"
        },
        "configuration_work_generation_digest_ck": {
          "name": "configuration_work_generation_digest_ck",
          "value": "\"control\".\"configuration_work\".\"generation_digest\" is null or \"control\".\"configuration_work\".\"generation_digest\" ~ '^sha256:[0-9a-f]{64}$'"
        },
        "configuration_work_predecessor_digest_ck": {
          "name": "configuration_work_predecessor_digest_ck",
