          "name": "configuration_work_kind_ck",
          "value": "\"control\".\"configuration_work\".\"work_kind\" in ('PROVIDER_QUALIFICATION','INDEXER_ADMISSION','PROJECTION_VALIDATION','RUNTIME_ACTIVATION')"
