              "method",
              "observationKind",
              "observationDigest"
            ]
          }
        }
      },
      "required": [
        "operationId",
        "state",
        "targetState",
        "attempts"
      ]
    },
    "RecoverCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionIntentId": {
          "const": "ACT-SIGNING_KEY_ROTATIONS_RECOVER_RESOURCE-V1"
        },
        "actionIntentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "originalOperationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "priorObservationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "actionIntentId",
        "actionIntentDigest",
        "expectedRevision",
        "reason",
        "originalOperationId",
        "attemptId",
        "priorObservationDigest"
      ]
    },
    "OperationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NO_NEW_OBSERVATION",
            "NEW_OBSERVATION",
            "LOOKUP_UNAVAILABLE",
            "SIGNATURE_UNAVAILABLE",
            "NO_EFFECT_RETRYABLE",
            "PROVIDER_REJECTED",
            "AUTHORITY_CHANGED_BEFORE_DISPATCH",
            "AUTHORITY_RENEWED",
            "FORWARD_RECOVERY"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "code": {
          "const": "PC-INTEGRATION-5001"
        },
        "originalOperationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "observationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "ApprovalRequired": {
      "type": "object",
      "additionalProperties": false,
      "description": "A staged server-derived candidate awaiting the existing distinct-checker approval process. This is not an applied operation. Replay the exact command after approval.",
      "properties": {
        "state": {
          "const": "APPROVAL_REQUIRED"
        },
        "resourceRef": {
          "type": "string",
          "pattern": "^urn:openpc:resource:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "actionIntentId": {
          "enum": [
            "ACT-SIGNING_KEY_ROTATIONS_ADVANCE_RESOURCE-V1",
            "ACT-SIGNING_KEY_ROTATIONS_RECOVER_RESOURCE-V1"
          ]
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "candidateRef": {
          "type": "string",
          "pattern": "^urn:openpc:resource:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "state",
        "resourceRef",
        "actionIntentId",
        "expectedRevision",
        "candidateRef",
        "candidateDigest"
      ]
    },
    "CommandResponse": {
      "oneOf": [
        {
          "$ref": "control-api.schema.json#/$defs/Operation"
        },
        {
          "$ref": "#/$defs/ApprovalRequired"
        }
      ]
    }
  }
}
