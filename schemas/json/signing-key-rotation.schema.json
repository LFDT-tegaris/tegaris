    "HistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "priorState": {
          "anyOf": [
            {
              "enum": [
                "REQUESTED",
                "APPROVED",
                "PREPARED",
                "DISTRIBUTED",
                "VERIFIED",
                "CUTOVER_FENCED",
                "OBSERVING",
                "OLD_REVOKED",
                "OLD_RETIRED",
                "COMPLETE",
                "FAILED",
                "RECOVERING"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "REQUESTED",
            "APPROVED",
            "PREPARED",
            "DISTRIBUTED",
            "VERIFIED",
            "CUTOVER_FENCED",
            "OBSERVING",
            "OLD_REVOKED",
            "OLD_RETIRED",
            "COMPLETE",
            "FAILED",
            "RECOVERING"
          ]
        },
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "priorDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptNamespace": {
          "enum": [
            "CONTROL_SIGNING_LIFECYCLE_V1",
            null
          ]
        },
        "receiptOrdinal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "priorState",
        "state",
        "operationId",
        "digest",
        "priorDigest",
        "eventId",
        "receiptId",
        "evidenceId",
        "receiptNamespace",
        "receiptOrdinal"
      ]
    },
    "PendingOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "state": {
          "const": "WRITE_AMBIGUITY"
        },
        "targetState": {
          "enum": [
            "PREPARED",
            "DISTRIBUTED",
            "VERIFIED",
            "CUTOVER_FENCED",
            "OBSERVING",
            "OLD_REVOKED",
            "OLD_RETIRED",
            "COMPLETE"
          ]
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attemptId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
