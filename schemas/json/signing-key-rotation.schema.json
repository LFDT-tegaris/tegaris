          "maxLength": 1024
        }
      },
      "required": [
        "actionIntentId",
        "actionIntentDigest",
        "expectedRevision",
        "reason"
      ]
    },
    "RotationPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rotation"
          }
        },
        "total": {
          "type": "string"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "const": "COMPLETE"
        },
        "authorizedEmpty": {
          "type": "boolean"
        },
        "snapshotRevision": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "total",
        "nextCursor",
        "completeness",
        "authorizedEmpty",
        "snapshotRevision"
      ]
    },
    "Key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "maxLength": 331,
          "pattern": "^secret://[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._/-]{1,192}#[A-Za-z0-9._-]{1,96}$",
          "description": "An exact version; latest/current aliases (any case) are rejected."
        },
        "keyEpoch": {
          "type": "string"
        },
        "publicKeySpkiHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{182}$"
        },
        "admissionKind": {
          "enum": [
            "BOOTSTRAP",
            "GOVERNED"
          ]
        },
        "admissionReference": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ADMITTED",
            "ACTIVE",
            "RETIRED",
            "REVOKED",
            "COMPROMISED"
          ]
        },
        "validFromNs": {
          "type": "string"
        },
        "validUntilNs": {
          "type": "string"
        },
        "signerRole": {
          "enum": [
            "BUSINESS_EFFECT",
            "LIFECYCLE_EVIDENCE"
          ]
        }
      },
      "required": [
        "fingerprint",
        "reference",
        "keyEpoch",
        "publicKeySpkiHex",
        "admissionKind",
        "admissionReference",
        "state",
        "validFromNs",
        "validUntilNs",
        "signerRole"
      ]
    },
    "KeyPage": {
      "type": "object",
