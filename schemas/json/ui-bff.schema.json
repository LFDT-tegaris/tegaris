{
  "$defs": {
    "UiAuthorizedActionV1": {
      "additionalProperties": false,
      "properties": {
        "actionIntentDigest": {
          "$ref": "shared-primitives.schema.json#/$defs/Sha256Digest"
        },
        "actionIntentId": {
          "pattern": "^ACT-[A-Z][A-Z0-9_]*-V[1-9][0-9]*$",
          "type": "string"
        },
        "etagRequired": {
          "type": "boolean"
        },
        "idempotency": {
          "enum": [
            "KEY_UNTIL_TERMINAL",
            "KEY_24H_MINIMUM",
            "NEVER_REPLAY_EFFECT"
          ]
        },
        "method": {
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "operationId": {
          "pattern": "^[a-z][A-Za-z0-9]+$",
          "type": "string"
        },
        "path": {
          "pattern": "^/api/v1/",
          "type": "string"
        },
        "riskClass": {
          "enum": [
            "LOW",
            "STANDARD",
            "HIGH",
            "BREAK_GLASS"
          ]
        },
        "stepUp": {
          "enum": [
            "NONE",
            "FRESH_WEBAUTHN_MAX_5M",
            "BREAK_GLASS_PROFILE"
          ]
        }
      },
      "required": [
        "actionIntentId",
        "actionIntentDigest",
