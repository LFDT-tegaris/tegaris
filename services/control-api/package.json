    "lint": "pnpm exec eslint src",
    "format": "pnpm exec prettier --check src"
  },
  "dependencies": {
    "@openpc/security-kernel": "workspace:*",
    "@noble/hashes": "2.3.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
